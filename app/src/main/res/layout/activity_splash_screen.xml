<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hero_home">

  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingHorizontal="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="132dp"
        android:layout_height="132dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="66dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/primary_cyan"
        app:strokeWidth="3dp">

      <ImageView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@string/app_sawit"
          android:padding="16dp"
          android:src="@drawable/logo_palmventory" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/app_sawit"
        android:textColor="@color/white"
        android:textSize="32sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="@string/tagline"
        android:textColor="@color/biru_muda"
        android:textSize="14sp" />

    <ProgressBar
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="28dp"
        android:indeterminateTint="@color/white" />
  </LinearLayout>

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|center_horizontal"
      android:layout_marginBottom="36dp"
      android:fontFamily="@font/poppins_medium"
      android:text="@string/splash_version"
      android:textColor="@color/biru_muda"
      android:textSize="12sp" />
</FrameLayout>