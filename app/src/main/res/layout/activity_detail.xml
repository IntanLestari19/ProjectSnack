<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink_kotak_gizi"
    tools:context=".pertemuan_3.DetailActivity"
    tools:layout_editor_absoluteX="0dp"
    tools:layout_editor_absoluteY="23dp">

    <TextView
        android:id="@+id/deskripsi3"
        android:layout_width="290dp"
        android:layout_height="39dp"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/averiaseriflibre_bold"
        android:text="@string/teks_judul_gizi"
        android:textColor="@color/abu_teks"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.223"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deskripsi" />

    <TextView
        android:id="@+id/deskripsi2"
        android:layout_width="359dp"
        android:layout_height="115dp"
        android:layout_marginBottom="28dp"
        android:fontFamily="@font/averiaserifsibre_light"
        android:text="@string/teks_gizi"
        android:textColor="@color/abu_teks"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.519"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deskripsi3"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="299dp"
        android:layout_height="96dp"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/alfaslabone_regular"
        android:text="@string/judul_detail"
        android:textColor="@color/pink_judul"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="322dp"
        android:layout_height="274dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5"
        app:srcCompat="@drawable/pocky" />

    <TextView
        android:id="@+id/deskripsi"
        android:layout_width="357dp"
        android:layout_height="93dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/averiaserifsibre_light"
        android:text="@string/teks_deskripsi"
        android:textColor="@color/abu_teks"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView2" />

</androidx.constraintlayout.widget.ConstraintLayout>

